{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Write(./workspace/**)",
      "Edit(./workspace/**)",
      "Write(./.claude/**)",
      "Edit(./.claude/**)",
      "Write(./.github/**)",
      "Edit(./.github/**)",
      "Agent"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/*.tfvars)"
    ]
  }
}
