{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Write(./workspace/**)",
      "Edit(./workspace/**)",
      "Write(./.claude/**)",
      "Edit(./.claude/**)",
      "Write(./.github/**)",
      "Edit(./.github/**)",
      "Agent"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/*.tfvars)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/package-docs/manual_hook.py\" post-edit",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
