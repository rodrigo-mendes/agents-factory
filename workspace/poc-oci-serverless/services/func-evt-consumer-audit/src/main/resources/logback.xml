<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</timestampPattern>
            <customFields>{"service":"func-evt-consumer-audit","cloud":"oci"}</customFields>
        </encoder>
    </appender>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Suppress OCI SDK internal noise -->
    <logger name="com.oracle.bmc"     level="WARN"/>
    <logger name="com.oracle.bmc.http" level="ERROR"/>
    <logger name="org.apache.http"    level="WARN"/>
    <logger name="org.glassfish"      level="WARN"/>
</configuration>
